# Path to the SQLite history store
WINNOW_DB_PATH=./data/winnow.db

# Coverage report format to parse: cobertura | coverage-py
WINNOW_COVERAGE_FORMAT=cobertura

# Minimum ML risk score required to add a test outside direct coverage
WINNOW_RISK_THRESHOLD=0.5

# Operating mode: bootstrap | backtest | live
WINNOW_MODE=bootstrap
